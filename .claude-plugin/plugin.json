{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "string",
  "displayName": "String",
  "version": "1.0.0",
  "description": "Search the web, read any public page and map a site's URLs, all returned as clean, LLM-ready Markdown for Claude.",
  "author": {
    "name": "String",
    "url": "https://usestring.ai"
  },
  "homepage": "https://portal.usestring.ai/docs/mcp/overview",
  "repository": "https://github.com/usestring/string-claude-plugin",
  "license": "MIT",
  "keywords": [
    "string",
    "web-access",
    "web-search",
    "web-fetch",
    "markdown",
    "research",
    "data-extraction",
    "sitemap",
    "mcp"
  ],
  "mcpServers": "./.mcp.json",
  "skills": [
    "./skills/web-search",
    "./skills/read-page",
    "./skills/map-site",
    "./skills/send-request"
  ]
}
